{
  "name": "robotik-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/copy-pyodide-assets.mjs && node scripts/build-worker.mjs && tsx scripts/build-search-index.ts && tsx scripts/build-evidence-manifest.ts && tsx scripts/build-continue-index.ts",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pyodide-assets.mjs && node scripts/build-worker.mjs && tsx scripts/build-search-index.ts && tsx scripts/build-evidence-manifest.ts && tsx scripts/build-continue-index.ts",
    "build": "next build && tsx scripts/check-no-draft-pages.ts && tsx scripts/check-release-output.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "check-content": "tsx scripts/check-content.ts",
    "validate-content-graph": "tsx scripts/validate-content-graph.ts",
    "build-search-index": "tsx scripts/build-search-index.ts",
    "build-evidence-manifest": "tsx scripts/build-evidence-manifest.ts",
    "build-continue-index": "tsx scripts/build-continue-index.ts",
    "check-no-draft-pages": "tsx scripts/check-no-draft-pages.ts",
    "check-release-output": "tsx scripts/check-release-output.ts",
    "check-quiz-dagilimi": "tsx scripts/check-quiz-dagilimi.ts",
    "check-mdx-guvenlik": "tsx scripts/check-mdx-guvenlik.ts",
    "review": "tsx scripts/review.ts",
    "check-review-debt": "tsx scripts/check-review-debt.ts",
    "check-review-integrity": "tsx scripts/check-review-integrity.ts",
    "check-sensitive-terms": "tsx scripts/check-sensitive-terms.ts",
    "check-performance-budget": "tsx scripts/check-performance-budget.ts",
    "measure:cwv": "tsx scripts/measure-cwv.ts",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/serve-static.mjs --port 3102 --root out",
    "generate-fixtures": "python reference-python/scripts/generate_fixtures.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "gray-matter": "4.0.3",
    "next": "16.3.0",
    "next-mdx-remote": "6.0.0",
    "pyodide": "314.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
